{
  "name": "nback-trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Dual and triple N-back working-memory trainer as an offline PWA, designed for foldable phones.",
  "type": "module",
  "scripts": {
    "test": "TZ=America/Chicago node --test tests/*.test.mjs",
    "e2e": "node tests/e2e.mjs",
    "lint": "eslint .",
    "start": "python3 -m http.server 8080 --directory www",
    "sync": "cap sync android",
    "open": "cap open android",
    "icons": "node scripts/render-icons.mjs",
    "screens": "node scripts/screenshots.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5"
  }
}
