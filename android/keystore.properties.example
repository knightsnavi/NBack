# Copy to android/keystore.properties (git-ignored) and fill in your values.
# Create the keystore once with:
#   keytool -genkeypair -v -keystore nback-release.jks -alias nback -keyalg RSA -keysize 2048 -validity 10000
storeFile=nback-release.jks
storePassword=CHANGE_ME
keyAlias=nback
keyPassword=CHANGE_ME
